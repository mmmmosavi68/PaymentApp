@model List<ExamSelectViewModel>
@{
    ViewData["Title"] = "خرید اعتبار جهت ثبت‌نام در آزمون‌ها";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <style>
        body { font-family: Tahoma, sans-serif; background: #f5f6f8; }
        .card { max-width: 720px; margin: 30px auto; }
        .notice-list li { margin-bottom: 8px; }
    </style>
</head>
<body>
    <div class="card shadow-sm">
        <div class="card-body">
            <h4 class="mb-3">@ViewData["Title"]</h4>

            <a href="http://sanjeshp.ir/" class="d-block mb-3">بازگشت به سایت اصلی</a>

            <p class="text-danger fw-bold">قبل از اقدام به پرداخت هزینه آزمون به نکات زیر توجه فرمایید:</p>
            <ol class="notice-list">
                <li>دفترچه راهنمای مربوط به آزمون مورد نظر را به‌طور دقیق مطالعه فرمایید، پس از پرداخت هزینه و دریافت شماره پیگیری تراکنش، هزینه پرداختی قابل استرداد نخواهد بود.</li>
                <li>پرداخت هزینه به منزله ثبت‌نام نمی‌باشد و داوطلب موظف است پس از پرداخت هزینه موفق، مجدداً وارد فرم ثبت‌نام آزمون مورد نظر خود شده و ثبت‌نام خود را تکمیل نماید.</li>
                <li>در انتخاب عنوان آزمون جهت پرداخت دقت فرمایید زیرا هزینه پرداختی برای هر آزمون، به همان آزمون اختصاص داشته و قابل تبدیل یا تغییر برای استفاده در آزمونی دیگر نخواهد بود.</li>
                <li>جهت پرداخت هزینه آزمون، مشخصات داوطلب باید دقیق و صحیح وارد گردد زیرا هزینه آزمون به کد ملی وارد‌شده اختصاص داده می‌شود.</li>
                <li class="fw-bold">(مهم) در صورتی‌ که پس از تایید پرداخت و کسر هزینه، مجدداً پرداخت نمایید، مبلغ دریافت‌شده قابل استرداد نخواهد بود.</li>
            </ol>

            <hr />
            <h6 class="mb-3">آزمون مورد نظر را انتخاب نمایید</h6>

            <form id="examForm">
                @foreach (var exam in Model)
                {
                    <div class="form-check border rounded p-2 mb-2">
                        <input class="form-check-input" type="radio" name="examId" id="exam_@exam.ExamId"
                               value="@exam.ExamId" data-title="@exam.Title" data-amount="@exam.Amount">
                        <label class="form-check-label w-100" for="exam_@exam.ExamId">
                            @exam.Title
                            <span class="float-start text-muted">@exam.Amount.ToString("N0") ریال</span>
                        </label>
                    </div>
                }

                <button type="button" id="btnSelect" class="btn btn-primary w-100 mt-3">ادامه</button>
            </form>
        </div>
    </div>

    <!-- مودال تایید -->
    <div class="modal fade" id="confirmModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">تایید آزمون انتخابی</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    آزمون: <strong id="confirmTitle"></strong><br />
                    مبلغ: <strong id="confirmAmount"></strong> ریال<br /><br />
                    آیا از انتخاب خود مطمئن هستید؟
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                    <a id="btnConfirm" href="#" class="btn btn-primary">بله، ادامه بده</a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('btnSelect').addEventListener('click', function () {
            var selected = document.querySelector('input[name="examId"]:checked');
            if (!selected) {
                alert('لطفا یک آزمون را انتخاب کنید.');
                return;
            }
            document.getElementById('confirmTitle').innerText = selected.dataset.title;
            document.getElementById('confirmAmount').innerText = Number(selected.dataset.amount).toLocaleString();
            document.getElementById('btnConfirm').href = '@Url.Action("Register", "Payment", new { area = "Payment" })?examId=' + selected.value;

            var modal = new bootstrap.Modal(document.getElementById('confirmModal'));
            modal.show();
        });
    </script>
</body>
</html>